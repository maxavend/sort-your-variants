{
  "name": "Sort your variants",
  "version": "1.0.0",
  "description": "Organiza las variantes de un Component Set en una grilla con etiquetas",
  "main": "code.js",
  "scripts": {
    "build": "npm run build:code && npm run build:ui",
    "build:code": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:ui": "vite build --watch",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --ignore-pattern dist --fix .",
    "release:check": "npm run lint && npm run build && node scripts/check-release.mjs"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "@rogieking/figui3": "11.2.2"
  }
}
